<section class="section {{ roomsClass or 'blush' }}" id="rooms">
  <div class="wrap rooms-band">
    <div>
      <p class="kicker">Stay upstairs</p>
      <h2>{{ v.rooms.count }} rooms, breakfast included</h2>
      <p>{{ v.rooms.summary }} Good for {{ v.rooms.goodFor }}.</p>
      <ul class="kit" style="margin-bottom:18px">{% for k in v.rooms.kit %}<li>{{ k }}</li>{% endfor %}</ul>
      <ul class="facts-row"><li>Check-in 3pm</li><li>Check-out 11am</li><li>Breakfast 7.30–11.30</li></ul>
      <div class="btn-row">
        {%- if v.rooms.booking %}
        <a class="btn btn--rose" href="{{ v.rooms.booking }}" rel="noopener">Book direct</a>
        {%- else %}
        <a class="btn btn--rose" href="tel:{{ v.phone | replace(' ', '') }}">Call to book a room</a>
        <a class="btn btn--ghost" href="mailto:{{ v.email }}?subject=Room%20booking">Email us</a>
        {%- endif %}
        <a class="btn btn--ghost" href="{{ ('/stay/#stay-' + v.slug) | u }}">Compare all four hotels</a>
      </div>
    </div>
    <div data-slides>
      <div class="slides" tabindex="0" aria-label="{{ v.name }} rooms">
        {%- for r in v.rooms.types %}
        <figure class="slide">
          <span class="photo">{% img r.image, v.name + " " + r.name, "(min-width: 900px) 55vw, 100vw" %}</span>
          <figcaption><b>{{ r.name }}</b>{{ r.text }}</figcaption>
        </figure>
        {%- endfor %}
      </div>
      <div class="slides-nav">
        <button type="button" data-prev aria-label="Previous room">←</button>
        <span data-slide-count>1 / {{ v.rooms.types.length }}</span>
        <button type="button" data-next aria-label="Next room">→</button>
      </div>
    </div>
  </div>
</section>
