<form class="form" data-mock="party" novalidate>
  <div class="form__row form__row--2">
    <label>Which Belle?
      <select name="venue" required>
        <option value="">Help me choose</option>
        {%- for v in venues %}<option value="{{ v.slug }}"{% if partyVenue == v.slug %} selected{% endif %}>{{ v.name }}</option>{% endfor %}
      </select>
    </label>
    <label>What's the occasion?
      <select name="occasion" required>
        {%- for o in ["Christmas party", "Christmas Day lunch", "Work do or team social", "Meeting or breakfast briefing", "Birthday", "Engagement or wedding reception", "Baby shower", "Leaving do", "Stag or hen do", "Watch party", "Wake", "Something else"] %}
        <option{% if partyOccasion == o %} selected{% endif %}>{{ o }}</option>
        {%- endfor %}
      </select>
    </label>
  </div>
  <div class="form__row form__row--2">
    <label>Date <input type="date" name="date" min="2026-10-17" required></label>
    <label>Roughly how many? <input type="number" name="guests" min="2" max="300" value="20" inputmode="numeric" required></label>
  </div>
  {%- if showMenuChoice %}
  <fieldset class="form__chips">
    <legend>Food</legend>
    <label><input type="radio" name="menu" value="set" checked> Set menu</label>
    <label><input type="radio" name="menu" value="buffet"> Buffet (15+)</label>
    <label><input type="radio" name="menu" value="drinks"> Just drinks</label>
  </fieldset>
  {%- endif %}
  <div class="form__row form__row--2">
    <label>Name <input type="text" name="name" autocomplete="name" required></label>
    <label>Email <input type="email" name="email" autocomplete="email" required></label>
  </div>
  <label>Anything we should know? <span class="opt">optional</span>
    <textarea name="notes" rows="3" placeholder="Dietary needs, a cake to hide, the boss's favourite team…"></textarea>
  </label>
  <button class="btn btn--rose btn--wide" type="submit">Send my enquiry</button>
</form>
